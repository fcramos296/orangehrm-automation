# Copie para .env e ajuste. Variáveis de ambiente têm precedência sobre o arquivo.

# Demo pública (padrão). Somente cenários de leitura.
ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_ADMIN_USERNAME=Admin
ORANGEHRM_ADMIN_PASSWORD=admin123

# Ambiente isolado (infra/docker-compose.yml): habilita os cenários que gravam.
# ORANGEHRM_BASE_URL=http://localhost:8080
# ORANGEHRM_ALLOW_WRITE=true

# ORANGEHRM_DEFAULT_TIMEOUT_MS=15000
# ORANGEHRM_NAVIGATION_TIMEOUT_MS=30000
# ORANGEHRM_LOCALE=en-US
# ORANGEHRM_TIMEZONE_ID=America/Sao_Paulo
